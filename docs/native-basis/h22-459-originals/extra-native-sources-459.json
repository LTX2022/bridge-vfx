      "lines": [
        {
          "line": 26,
          "text": "#define UT_RELEASE_VERSION SYS_VERSION_RELEASE"
        },
        {
          "line": 27,
          "text": ""
        },
        {
          "line": 28,
          "text": "// The major version.  .9 counts as next higher."
        },
        {
          "line": 29,
          "text": "#define UT_MAJOR_VERSION SYS_VERSION_MAJOR"
        },
        {
          "line": 30,
          "text": "#define UT_MINOR_VERSION SYS_VERSION_MINOR"
        },
        {
          "line": 31,
          "text": ""
        },
        {
          "line": 32,
          "text": "// Version numbers as integer values"
        },
        {
          "line": 33,
          "text": "#define UT_MAJOR_VERSION_INT SYS_VERSION_MAJOR_INT"
        },
        {
          "line": 34,
          "text": "#define UT_MINOR_VERSION_INT SYS_VERSION_MINOR_INT"
        },
        {
          "line": 35,
          "text": "#define UT_BUILD_VERSION_INT SYS_VERSION_BUILD_INT"
        },
        {
          "line": 36,
          "text": "#define UT_PATCH_VERSION_INT SYS_VERSION_PATCH_INT"
        },
        {
          "line": 37,
          "text": ""
        },
        {
          "line": 38,
          "text": "// Version as a packed integer: (\"%02x%02x%04x\", major, minor, build)"
        },
        {
          "line": 39,
          "text": "#define UT_VERSION_INT SYS_VERSION_FULL_INT"
        },
        {
          "line": 40,
          "text": ""
        },
        {
          "line": 41,
          "text": ""
        },
        {
          "line": 42,
          "text": "/// The version string to insert in paths for save directories."
        },
        {
          "line": 43,
          "text": "#define UT_SAVE_VERSION SYS_VERSION_RELEASE"
        },
        {
          "line": 44,
          "text": ""
        },
        {
          "line": 45,
          "text": ""
        },
        {
          "line": 46,
          "text": "/// Return the full major.minor.build version."
        },
        {
          "line": 47,
          "text": "inline const char *UTgetFullVersion() { return SYS_Version::full(); }"
        },
        {
          "line": 48,
          "text": "/// Return the \"major.minor\" release version"
        },
        {
          "line": 49,
          "text": "inline const char *UTgetReleaseVersion() { return SYS_Version::release(); }"
        },
        {
          "line": 50,
          "text": "/// Return the \"major\" version"
        },
        {
          "line": 51,
          "text": "inline const char *UTgetMajorVersion()\t{ return SYS_Version::major(); }"
        },
        {
          "line": 52,
          "text": "/// Return the version used for save directories"
        },
        {
          "line": 53,
          "text": "inline const char *UTgetSaveVersion()\t{ return SYS_Version::release(); }"
        },
        {
          "line": 54,
          "text": ""
        }
