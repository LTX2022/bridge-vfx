      "lines": [
        {
          "line": 138,
          "text": "\thelp\t\"Force compression, even when not writing to a disk file.  This may break rendering.\""
        },
        {
          "line": 139,
          "text": "    }"
        },
        {
          "line": 140,
          "text": "    parm {"
        },
        {
          "line": 141,
          "text": "\tname\tsoho_foreground"
        },
        {
          "line": 142,
          "text": "\tlabel\t\"Wait for Render to Complete\""
        },
        {
          "line": 143,
          "text": "\ttype\ttoggle"
        },
        {
          "line": 144,
          "text": "\tparmtag\t{ spare_category\t\"SOHO Intrinsics\" }"
        },
        {
          "line": 145,
          "text": "\tdefault\t{ 0 }"
        },
        {
          "line": 146,
          "text": "\tdisablewhen\t\"{ soho_outputmode != 0 }\""
        },
        {
          "line": 147,
          "text": "\thelp\t\"When rendering to the soho_pipecmd, turning this on will block Houdini until the pipe command completes.\""
        },
        {
          "line": 148,
          "text": "    }"
        },
        {
          "line": 149,
          "text": "    parm {"
        },
        {
          "line": 150,
          "text": "\tname\tsoho_mkpath"
        },
        {
          "line": 151,
          "text": "\tlabel\t\"Create Intermediate Directories\""
        },
        {
          "line": 152,
          "text": "\ttype\ttoggle"
        },
        {
          "line": 153,
          "text": "\tparmtag\t{ spare_category\t\"SOHO Intrinsics\" }"
        },
        {
          "line": 154,
          "text": "\tdefault\t{ 1 }"
        },
        {
          "line": 155,
          "text": "\thelp\t\"If enabled, this will cause intermediate directories of output files to be created.\""
        },
        {
          "line": 156,
          "text": "    }"
        }
      ],
      "scope": "static native source only; no function/menu/expression execution"
